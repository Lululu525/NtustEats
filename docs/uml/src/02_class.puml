@startuml
!include _style.iuml
title NTUST Eats — Class Diagram (Domain Model)
hide empty members
left to right direction
abstract class Customer {
  id: UUID
  name: String
  email: String
  priceType: PriceType
}
class Member {
  studentNo: String
}
class Visitor {
  phone: String
}
class VendorStaff
class Admin
class Store {
  name: String
  openHours: TimeRange[]
  prepMinutes: int = 10
  slotCapacity: int = 15
}
class MenuCategory {
  name: String
}
class MenuItem {
  name: String
  nameEn: String
  campusPrice: int
  offCampusPrice: int
  tags: Set<Tag>
  soldOut: bool
  +priceFor(PriceType): int
}
class Cart {
  +splitByStore(): Order[]
}
class CartLine {
  qty: int
  options: String
}
class Order {
  no: String  <<4 碼>>
  qrToken: String  <<128-bit>>
  status: OrderStatus
  total: int
  submittedAt: DateTime
  +cancel()
  +accept()
  +markReady()
  +pickUp()
}
class PickupSlot {
  start: Time
  booked: int
  +hasRoom(): bool
}
class Report {
  +byStoreAndSlot()
  +exportCsv(): File
}
class Payment {
  method: PayMethod
  amount: int
  +charge()
  +refund()
}
class Delivery {
  address: String
  fee: int
}
class Recommendation {
  +suggest(customer): MenuItem[]
}
enum OrderStatus {
  SUBMITTED
  ACCEPTED
  READY
  PICKED_UP
  CANCELLED
  REJECTED
}
enum PriceType {
  CAMPUS
  OFF_CAMPUS
}
Customer <|-- Member
Customer <|-- Visitor
Store "1" *-- "1..*" MenuCategory
MenuCategory "1" *-- "1..*" MenuItem
Store "1" o-- "1..*" VendorStaff
Store "1" *-- "0..*" PickupSlot
Customer "1" -- "1" Cart
Cart "1" *-- "0..*" CartLine
CartLine --> MenuItem
Customer "1" -- "0..*" Order : places
Order "0..*" --> "1" Store
Order "0..*" --> "1" PickupSlot
Order "1" -- "0..1" Payment
Order "1" -- "0..1" Delivery
Recommendation ..> MenuItem
Admin ..> Report
@enduml
