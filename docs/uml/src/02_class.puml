@startuml
!include _style.iuml
title NTUST Eats — Class Diagram (Domain Model)
hide empty members
left to right direction
abstract class Customer {
  id: UUID
  name: String
  email: String
  priceType: PriceType
  suspendedUntil: DateTime
  +canOrder(): bool
}
class Member {
  studentNo: String
}
class Visitor {
  phone: String
}
class VendorStaff
class Admin
class Store {
  name: String
  openHours: TimeRange[]
  prepMinutes: int = 10
  slotCapacity: int = 15
}
class MenuCategory {
  name: String
}
class MenuItem {
  name: String
  nameEn: String
  campusPrice: int
  offCampusPrice: int
  tags: Set<Tag>
  soldOut: bool
  +priceFor(PriceType): int
  +validatePrice(): Warning[]
}
class AddOnRule {
  allowedParents: MenuItem[]
}
class BowlBuilder {
  broth: Broth  {必選 1}
  pick4: MenuItem[4]
  extras: MenuItem[]
  +isValid(): bool
}
class Promotion {
  before: Time = 10:00
  trigger: ItemMatcher
  reward: Reward
  +applies(order, time): bool
}
class Cart {
  +splitByStore(): Order[]
}
class CartLine {
  qty: int
  options: String
}
class Order {
  no: String  <<4 碼>>
  qrToken: String  <<128-bit>>
  status: OrderStatus
  total: int
  submittedAt: DateTime
  +cancel()
  +accept()
  +markReady()
  +pickUp()
}
class PickupSlot {
  start: Time
  booked: int
  +hasRoom(): bool
}
class Suspension {
  noShowCount30d: int
  until: DateTime
}
class Report {
  +byStoreAndSlot()
  +exportCsv(): File
}
enum OrderStatus {
  SUBMITTED
  ACCEPTED
  READY
  PICKED_UP
  CANCELLED
  REJECTED
  NO_SHOW
}
enum PriceType {
  CAMPUS
  OFF_CAMPUS
}
Customer <|-- Member
Customer <|-- Visitor
Store "1" *-- "1..*" MenuCategory
MenuCategory "1" *-- "1..*" MenuItem
MenuItem "1" -- "0..1" AddOnRule : 加購限制
Store "1" o-- "0..*" Promotion
Store "1" o-- "1..*" VendorStaff
Store "1" *-- "0..*" PickupSlot
Customer "1" -- "1" Cart
Cart "1" *-- "0..*" CartLine
CartLine --> MenuItem
CartLine "0..1" -- "0..1" BowlBuilder
Customer "1" -- "0..*" Order : places
Order "0..*" --> "1" Store
Order "0..*" --> "1" PickupSlot
Customer "1" -- "0..1" Suspension
Admin ..> Report
@enduml
