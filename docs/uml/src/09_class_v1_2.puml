@startuml
!include _style.iuml
title NTUST Eats — Class Diagram v1.2（含 CR-06～CR-09）
hide empty members
left to right direction
abstract class Customer {
  id: UUID
  name: String
  email: String
  priceType: PriceType
  suspendedUntil: DateTime
  +canOrder(): bool
}
class Member {
  studentNo: String
  dept: String
  +verifyWithRegistry(idNo): bool
}
class Visitor {
  phone: String
}
class VendorStaff {
  password: Hash
}
class Admin
class Area {
  name: String  <<第一餐廳／T2>>
}
class Store {
  name: String
  accepting: bool
  openHours: TimeRange[]
  prepMinutes: int = 10
  slotCapacity: int = 15
}
class MenuCategory {
  name: String
}
class MenuItem {
  name: String
  nameEn: String
  campusPrice: int
  offCampusPrice: int
  tags: Set<Tag>
  soldOut: bool
  +priceFor(PriceType): int
  +validatePrice(): Warning[]
}
class AddOnRule {
  allowedParents: MenuItem[]
}
class BowlBuilder {
  broth: Broth  {必選 1}
  pick4: MenuItem[4]
  extras: MenuItem[]
  +isValid(): bool
}
class Promotion {
  before: Time = 10:00
  trigger: ItemMatcher
  reward: Reward
  +applies(order, time): bool
}
class Cart {
  +splitByStore(): Order[]
}
class CartLine {
  qty: int
  options: String
}
class Order {
  no: String  <<4 碼>>
  qrToken: String  <<128-bit>>
  status: OrderStatus
  total: int
  submittedAt: DateTime
  +cancel()
  +accept()
  +markReady()
  +handOver()
  +complete()
  +correctNoShow()
}
class Payment {
  method: PayMethod
  amount: int
  status: PayStatus
  +refund()
}
class Wallet {
  balance: int
  +pay(amount)
  +refund(amount)
}
class WalletTx {
  type: 儲值／付款／退款
  amount: int
  at: DateTime
}
enum PayMethod {
  LINE_PAY
  CAMPUS_WALLET
}
class PickupSlot {
  start: Time
  booked: int
  +hasRoom(): bool
}
class Suspension {
  noShowCount30d: int
  until: DateTime
}
class Report {
  +byStoreAndSlot()
  +exportCsv(): File
}
enum OrderStatus {
  SUBMITTED
  ACCEPTED
  READY
  HANDED_OVER
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}
enum PriceType {
  CAMPUS
  OFF_CAMPUS
}
Customer <|-- Member
Customer <|-- Visitor
Area "1" *-- "1..*" Store
Store "1" *-- "1..*" MenuCategory
MenuCategory "1" *-- "1..*" MenuItem
MenuItem "1" -- "0..1" AddOnRule : 加購限制
Store "1" o-- "0..*" Promotion
Store "1" o-- "1..*" VendorStaff
Store "1" *-- "0..*" PickupSlot
Customer "1" -- "1" Cart
Cart "1" *-- "0..*" CartLine
CartLine --> MenuItem
CartLine "0..1" -- "0..1" BowlBuilder
Customer "1" -- "0..*" Order : places
Order "0..*" --> "1" Store
Order "0..*" --> "1" PickupSlot
Customer "1" -- "0..1" Suspension
Admin ..> Report
Order "1" -- "1" Payment
Member "1" -- "1" Wallet
Wallet "1" *-- "0..*" WalletTx
Payment ..> Wallet : CAMPUS_WALLET
@enduml
